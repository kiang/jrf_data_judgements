n │      │  │年│94                        │                          │\n │  確  │案├─┼─────────────┼─────────────┤\n │      │  │字│訴                        │                          │\n │  定  │號├─┼─────────────┼─────────────┤\n │      │  │號│965                       │                          │\n │  日  ├─┼─┼─────────────┼─────────────┤\n │      │確│年│94                        │                          │\n │  期  │定├─┼─────────────┼─────────────┤\n │      │日│月│10                        │                          │\n │      │期├─┼─────────────┼─────────────┤\n │      │  │日│24                        │                          │\n ├───┴─┴─┼─────────────┼─────────────┤\n │合於中華民國九│第2條第1項第3款           │                          │\n │十六年罪犯減刑│                          │                          │\n │條例          │                          │                          │\n ├───────┼─────────────┼─────────────┤\n │減刑刑期褫奪公│有期徒刑7月。             │                          │\n │權期間或罰金額│                          │                          │\n ├───────┼─────────────┼─────────────┤\n │ 附         註│                          │                          │\n └───────┴─────────────┴─────────────┘\n",
