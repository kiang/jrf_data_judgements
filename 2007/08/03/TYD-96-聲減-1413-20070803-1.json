─┤\n│      │確│年│      94        │      94        │      95        │      95        │\n│  期  │定├─┼────────┼────────┼────────┼────────┤\n│      │日│月│      11        │      11        │      7         │      7         │\n│      │期├─┼────────┼────────┼────────┼────────┤\n│      │  │日│      10        │      10        │      24        │      24        │\n├───┴─┴─┼────────┼────────┼────────┼────────┤\n│合於中華民國九│                │                │                │                │\n│十六年罪犯減刑│ 第2條第1項第3款│第2條第1項第3款 │第2條第1項第3款 │第2條第1項第3款 │\n│條例          │                │                │                │                │\n├───────┼────────┼────────┼────────┼────────┤\n│減刑刑期褫奪公│  有期徒刑5月   │  有期徒刑5月   │有期徒刑4月又15 │ 有期徒刑2月    │\n│權期間或罰金額│                │                │日              │                │\n├───────┼────────┼────────┼────────┼────────┤\n│易科罰金之折算│銀元佰元即新台│銀元佰元即新台│銀元佰元即新台│銀元佰元即新台│\n│標準          │幣玖佰元折算壹日│幣玖佰元折算壹日│幣玖佰元折算壹日│幣玖佰元折算壹日│\n└───────┴────────┴────────┴────────┴────────┘\n",
