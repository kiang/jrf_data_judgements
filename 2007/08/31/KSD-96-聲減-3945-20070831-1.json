                       │項                        │\n├───────┼─────────────┼─────────────┤\n│  犯 罪 日 期 │93年6 月16日至93年10月8 日│93年6 月16日至93年10月8 日│\n├───────┼─────────────┼─────────────┤\n│偵查機關、年度│臺灣高雄地方法院檢察署    │臺灣高雄地方法院檢察署    │\n│及案號        ├─────────────┼─────────────┤\n│              │93年度毒偵字第3207號      │93年度毒偵字第3207號      │\n├───┬───┼─────────────┼─────────────┤\n│  最  │法院  │臺灣高雄地方法院          │臺灣高雄地方法院          │\n│  後  ├───┼─────────────┼─────────────┤\n│  事  │案號  │93年度訴字第3352號        │93年度訴字第3352號        │\n│  實  ├───┼─────────────┼─────────────┤\n│  審  │判決  │94年3月31日               │94年3月31日               │\n│      │日期  │                          │                          │\n├───┼───┼─────────────┼─────────────┤\n│  判  │法院  │臺灣高雄地方法院          │臺灣高雄地方法院          │\n│  決  ├───┼─────────────┼─────────────┤\n│  確  │案號  │93年度訴字第3352號        │93年度訴字第3352號        │\n│  定  ├───┼─────────────┼─────────────┤\n│  日  │確定  │94年5月9日                │94年5月9日                │\n│  期  │日期  │                          │                          │\n├───┴───┼─────────────┴─────────────┤\n│定應執行刑    │有期徒刑1年2月(臺灣高雄地方法院93年度訴字第3352號)    │\n├───────┼─────────────┬─────────────┤\n│合於中華民國九│第2條第1項第3款           │第2條第1項第3款           │\n│十六年罪犯減刑│                          │                          │\n│條例          │                          │                          │\n├───────┼─────────────┼─────────────┤\n│減刑後之宣告刑│有期徒刑4月15日           │有期徒刑3月               │\n├───────┼─────────────┴─────────────┤\n│減刑後之應執行│有期徒刑7月                                           │\n│刑            │                                                      │\n└───────┴───────────────────────────┘\n",
