         │\n├───────┼──────┼──────┼──────┤\n│  犯 罪 日 期 │89年12月30日│87年04月06日│            │\n├───┬───┼──────┼──────┼──────┤\n│偵  及│機  關│花蓮地方法院│花蓮地方法院│            │\n│      │      │檢察署      │檢察署      │            │\n│      ├───┼──────┼──────┼──────┤\n│查  案│  年  │91          │87          │            │\n│      ├───┼──────┼──────┼──────┤\n│年  號│  字  │毒偵        │偵          │            │\n│      ├───┼──────┼──────┼──────┤\n│度    │  號  │415         │760         │            │\n├───┼───┼──────┼──────┼──────┤\n│      │法  院│花蓮地方法院│花蓮高分院  │            │\n│      ├─┬─┼──────┼──────┼──────┤\n│      │  │年│93          │91          │            │\n│      │案├─┼──────┼──────┼──────┤\n│  最  │  │字│簡上        │上訴        │            │\n│      │號├─┼──────┼──────┼──────┤\n│  後  │  │號│44          │40          │            │\n│      ├─┼─┼──────┼──────┼──────┤\n│  事  │判│年│93          │91          │            │\n│      │決├─┼──────┼──────┼──────┤\n│  實  │日│月│06          │12          │            │\n│      │期├─┼──────┼──────┼──────┤\n│  審  │  │日│23          │18          │            │\n├───┼─┴─┼──────┼──────┼──────┤\n│      │法  院│花蓮地方法院│花蓮地方法院│            │\n│      ├─┬─┼──────┼──────┼──────┤\n│      │  │年│93          │92          │            │\n│      │案├─┼──────┼──────┼──────┤\n│      │  │字│簡上        │台上        │            │\n│  確  │號├─┼──────┼──────┼──────┤\n│      │  │號│44          │2621        │            │\n│  定  ├─┼─┼──────┼──────┼──────┤\n│      │確│年│93          │92          │            │\n│  日  │定├─┼──────┼──────┼──────┤\n│      │日│月│07          │05          │            │\n│  期  │期├─┼──────┼──────┼──────┤\n│      │  │日│30          │15          │            │\n├───┴─┴─┼──────┼──────┼──────┤\n│合於中華民國九│合          │合          │            │\n│十六年罪犯減刑│            │            │            │\n│條例          │            │            │            │\n├───────┼──────┼──────┼──────┤\n│減刑刑期褫奪公│2月15日     │1年         │            │\n│權期間或罰金額│            │            │            │\n├───────┼──────