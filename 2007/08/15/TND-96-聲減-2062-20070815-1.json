      │                      │\n│      │      │                  │                    │                      │\n│      ├─┬─┼─────────┼──────────┼───────────┤\n│      │  │年│95                │94                  │95                    │\n│  確  │案├─┼─────────┼──────────┼───────────┤\n│      │  │字│簡                │訴                  │訴                    │\n│  定  │號├─┼─────────┼──────────┼───────────┤\n│      │  │號│264               │1529                │806                   │\n│  日  ├─┼─┼─────────┼──────────┼───────────┤\n│      │確│年│95                │95                  │96                    │\n│  期  │定├─┼─────────┼──────────┼───────────┤\n│      │日│月│3                 │3                   │1                     │\n│      │期├─┼─────────┼──────────┼───────────┤\n│      │  │日│16                │20                  │8                     │\n├───┴─┴─┼─────────┼──────────┼───────────┤\n│合於中華民國九│第2條第1項第3款   │第2條第1項第3款     │第2條第1項第3款       │\n│十六年罪犯減刑│                  │                    │                      │\n│條例          │                  │                    │                      │\n├───────┼─────────┼──────────┼───────────┤\n│減刑刑期褫奪公│有期徒刑2月，如易 │有期徒刑4月又15日， │有期徒刑6月，如易科罰 │\n│權期間或罰金額│科罰金，以銀元300 │如易科罰金，以銀元  │金，以銀元300元即新台 │\n│              │元即新台幣900元折 │300元即新台幣900元折│幣900元折算1日        │\n│              │算1日             │算1日               │                      │\n├───────┼─────────┴──────────┼───────────┤\n│ 附         註│95年度聲字第832號定應執行刑1年          │不符合數罪併罰        │\n│              │（符合數罪併罰）                        │                      │\n└───────┴────────────────────┴───────────┘\n",
