、三層樓│樓58.58合計175.75     │.50、屋頂 │    │股份有限公司    │\n│    │      │              │              │房        │                      │突出物面積│    │                │\n│    │      │              │              │          │                      │7.04      │    │                │\n├──┼───┼───────┼───────┼─────┼───────────┼─────┼──┼────────┤\n│004 │667   │內埔鄉○○路15│南寧段732-9地 │鋼筋混凝土│1樓56.61、2樓58.58、3 │陽台面積11│全部│所有權人龍邦實業│\n│    │      │0巷5號        │號            │造、三層樓│樓58.58合計175.75     │.50、屋頂 │    │股份有限公司    │\n│    │      │              │              │房        │                      │突出物面積│    │                │\n│    │      │              │              │          │                      │7.04      │    │                │\n└──┴───┴───────┴───────┴─────┴───────────┴─────┴──┴────────┘\n",
