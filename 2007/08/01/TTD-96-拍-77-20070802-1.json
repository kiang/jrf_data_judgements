│積│積│  │        │  │  │      │            │\n│  │  │            │        │        ││││││││││││  │        │  │  │      │            │\n│  │  │            │        │        │  │  │  │  │  │  │  │  │  │  │  │  │        │  │  │      │            │\n│  │  │            │        │        │  │  │  │  │  │  │  │  │  │  │  │  │        │  │  │      │            │\n├─┼─┼──────┼────┼────┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼────┼─┼─┼───┼──────┤\n│０│１│知本路二段  │建康段  │三層鋼筋│５│５│３│  │  │  │  │  │  │  │  │１│２︽４︽│  │平│全部  │丙○○所有  │\n│０│７│550巷77弄15 │35-0125 │混凝土造│２│２│４│  │  │  │  │  │  │  │  │３│‧壹‧參│  │方│      │            │\n│１│９│號          │        │住家用  │‧│‧│‧│  │  │  │  │  │  │  │  │９│９層９層│  │公│      │            │\n│  │  │            │        │        │４│４│２│  │  │  │  │  │  │  │  │‧│７陽５陽│  │尺│      │            │\n│  │  │            │        │        │７│７│５│  │  │  │  │  │  │  │  │１│  台  台│  │  │      │            │\n│  │  │            │        │        │  │  │  │  │  │  │  │  │  │  │  │９│  ︾  ︾│  │  │      │            │\n└─┴─┴──────┴────┴────┴─┴─┴─┴─┴─┴─┴─┴─┴─┴─┴─┴─┴────┴─┴─┴───┴──────┘\n~t60;\n",
