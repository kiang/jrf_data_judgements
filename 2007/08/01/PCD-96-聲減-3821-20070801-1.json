                     │\n│  罪      名  │轉讓第一級毒品            │                          │\n├───────┼─────────────┤                          │\n│  宣  告  刑  │有期徒刑壹年捌月          │                          │\n├───────┼─────────────┤                          │\n│  所 犯 法 條 │毒品危害防制條例第8 條第1 │                          │\n│              │項                        │                          │\n├───────┼─────────────┤                          │\n│  犯 罪 日 期 │95年4月起至95年5月6日     │                          │\n├───┬───┼─────────────┤                          │\n│偵    │機  關│臺灣板橋地方法院檢察署    │                          │\n│    及├───┼─────────────┤                          │\n│查    │  年  │95                        │                          │\n│    案├───┼─────────────┤                          │\n│年    │  字  │偵                        │                          │\n│    號├───┼─────────────┤                          │\n│度    │  號  │12185                     │                          │\n├───┼───┼─────────────┤                          │\n│      │法  院│臺灣板橋地方法院          │                          │\n│      ├─┬─┼─────────────┤                          │\n│  最  │  │年│95                        │                          │\n│      │案├─┼─────────────┤                          │\n│  後  │  │字│訴                        │                          │\n│      │號├─┼─────────────┤                          │\n│  事  │  │號│1922                      │                          │\n│      ├─┼─┼─────────────┤                          │\n│  實  │判│年│95                        │                          │\n│      │決├─┼─────────────┤                          │\n│  審  │日│月│9                         │                          │\n│      │期├─┼─────────────┤                          │\n│      │  │日│29                        │                          │\n├───┼─┴─┼─────────────┤                          │\n│      │法  院│臺灣板橋地方法院          │                          │\n│      ├─┬─┼─────────────┤                          │\n│      │  │年│