│      │  │      │    │  │      │    │        │，如│            │\n│  │    │    │      │    │      │  │      │    │  │      │    │        │易科│            │\n│  │    │    │      │    │      │  │      │    │  │      │    │        │罰金│            │\n│  │    │    │      │    │      │  │      │    │  │      │    │        │以銀│            │\n│  │    │    │      │    │      │  │      │    │  │      │    │        │元三│            │\n│  │    │    │      │    │      │  │      │    │  │      │    │        │百元│            │\n│  │    │    │      │    │      │  │      │    │  │      │    │        │折算│            │\n│  │    │    │      │    │      │  │      │    │  │      │    │        │一日│            │\n├─┼──┼──┼───┼──┼───┼─┼───┼──┼─┼───┼──┼────┼──┼──────┤\n│4 │盜匪│有期│廢止前│85年│板橋地│臺│87年度│87年│臺│87年度│87年│不符減刑│不應│減刑條例第│\n│  │罪  │徒刑│之懲治│10月│檢86年│灣│上訴字│05月│灣│上訴字│06月│要件    │減刑│3條 第1 項第│\n│  │    │八年│盜匪條│16日│偵字第│高│第1313│13日│高│第1313│18日│        │    │17 款 所列之│\n│  │    │    │例第5 │    │21710 │等│號    │    │等│號    │    │        │    │罪（含有牽連│\n│  │    │    │條第1 │    │號    │法│      │    │法│      │    │        │    │犯裁判上一罪│\n│  │    │    │項第1 │    │      │院│      │    │院│      │    │        │    │關係之剝奪行│\n│  │    │    │款、刑│    │      │  │      │    │  │      │    │        │    │動自由罪），│\n│  │    │    │法第  │    │      │  │      │    │  │      │    │        │    │宣告刑逾有期│\n│  │    │    │302 條│    │      │  │      │    │  │      │    │        │    │徒刑一年六月│\n│  │    │    │第1 項│    │      │  │      │    │  │      │    │        │    │之刑。      │\n│  │    │    │      │    │      │  │      │    │  │      │    │        │    │執行殘刑三│\n│  │    │    │      │    │      │  │      │    │  │      │    │        │    │年三月二十一│\n│  │    │    │      │    │      │  │      │    │  │      │    │        │    │日。        │\n└─┴──┴──┴───┴──┴───┴─┴───┴──┴─┴───┴──┴────┴──┴──────┘\n",
