   │    │    │    │    │    │  │        │  │  │      │7平方 │\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │公尺, │\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │權利範│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │圍:100│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │00分之│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │24;興 │\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │村段13│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │94建號│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │,面積:│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │610.18│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │平方公│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │尺,權 │\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │利範圍│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │:10000│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │分之25│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │9     │\n├──┼──┼──────┼────┼────┼──┼──┼──┼──┼──┼──┼──┼─┼────┼─┼─┼───┼───┤\n│002 │1338│嘉義市○○街│嘉義市興│見使用執│地下│    │    │    │    │    │    │16│        │  │平│10000 │共用部│\n│    │    │107號地下二 │村段133 │照,鋼筋 │2層 │    │    │    │    │    │    │94│        │  │方│分之21│分:興 │\n│    │    │層樓        │地號,149│混凝土造│1694│    │  