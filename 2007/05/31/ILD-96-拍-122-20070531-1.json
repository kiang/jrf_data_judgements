    │    │    │用部分│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │：鹿安│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │一段62│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │建號61│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │.56 平│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │方公尺│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │，權利│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │範圍10│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │00分之│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │189   │\n└─┴──┴────┴────┴────┴───┴───┴───┴───┴───┴───┴────┴───┴──┴──┴───┘\n",
