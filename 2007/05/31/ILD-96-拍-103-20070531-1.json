    │    │    │61650 │\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │分之14│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │16；壯│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │一段34│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │82建號│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │，面積│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │1016.5│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │6平方 │\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │公尺，│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │權利範│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │圍：10│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │1656分│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │之472 │\n└─┴──┴────┴────┴────┴───┴───┴───┴───┴───┴───┴────┴───┴──┴──┴───┘\n",
