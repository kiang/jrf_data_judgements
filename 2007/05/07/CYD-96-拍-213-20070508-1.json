    │        │    │    │    │    │    │    │    │  │        │  │  │      │, 權利│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │範圍:1│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │000分 │\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │之29; │\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │竹圍子│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │段一小│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │段1329│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │建號, │\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │面積: │\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │59.81 │\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │平方公│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │尺,權 │\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │利範圍│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │:1000 │\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │分之17│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │; 竹圍│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │子段一│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │小段13│\n│    │    │            │        │        │    │    │    │    │  