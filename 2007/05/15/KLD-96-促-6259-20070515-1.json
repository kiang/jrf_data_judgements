             │\n│    │      │          ├──────┼──────┼───────┤\n│    │      │          │自民國94.01.│至民國94.03.│年息1.381%    │\n│    │      │          │03起        │27止        │              │\n│    │      │          ├──────┼──────┼───────┤\n│    │      │          │自民國94.03.│至民國94.07.│年息1.395%    │\n│    │      │          │28起        │03止        │              │\n│    │      │          ├──────┼──────┼───────┤\n│    │      │          │自民國94.07.│至民國94.09.│年息1.4%      │\n│    │      │          │04起        │18止        │              │\n│    │      │          ├──────┼──────┼───────┤\n│    │      │          │自民國94.09.│至民國94.12.│年息1.404%    │\n│    │      │          │19起        │25止        │              │\n│    │      │          ├──────┼──────┼───────┤\n│    │      │          │自民國94.12.│至民國95.04.│年息1.4076%   │\n│    │      │          │26起        │02止        │              │\n│    │      │          ├──────┼──────┼───────┤\n│    │      │          │自民國95.04.│至民國95.07.│年息1.4262%   │\n│    │      │          │03起        │02止        │              │\n│    │      │          ├──────┼──────┼───────┤\n│    │      │          │自民國95.07.│至民國95.10.│年息1.4456%   │\n│    │      │          │03起        │01止        │              │\n│    │      │          ├──────┼──────┼───────┤\n│    │      │          │自民國95.10.│至民國96.01.│年息1.465%    │\n│    │      │          │02起        │01止        │              │\n│    │      │          ├──────┼──────┼───────┤\n│    │      │          │自民國96.01.│至民國96.02.│年息1.2792%   │\n│    │      │          │02起        │26止        │              │\n│    │      │          ├──────┼──────┼───────┤\n│    │      │          │自民國96.02.│至清償日止  │年息1.2852%(浮│\n│    │      │          │27起        │            │              │\n│    │      │          │            │            │動)           │\n└──┴───┴─────┴──────┴──────┴───────┘\n合計金額：新臺幣11,465元整",
