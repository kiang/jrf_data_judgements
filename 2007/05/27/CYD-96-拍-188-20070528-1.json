 │  │        │  │  │      │,權利 │\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │範圍:1│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │0000分│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │之245;│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │嘉義市│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │北社尾│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │段2337│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │建號, │\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │面積:7│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │352.59│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │平方公│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │尺,權 │\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │利範圍│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │:10000│\n│    │    │            │        │        │    │    │    │    │    │    │    │  │        │  │  │      │分之24│\n└──┴──┴──────┴────┴────┴──┴──┴──┴──┴──┴──┴──┴─┴────┴─┴─┴───┴───┘\n",
