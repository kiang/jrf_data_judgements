  │  │  │  │  │  │  │  │  │合│主要│陽│雨│面│      │      │\n│編號│  │  建物門牌  │基地坐落│        │一│  │  │  │  │  │  │  │  │  │  │  │    │  │  │積│      │備  考│\n│    │  │            │        │材 料 及│層│  │  │  │  │  │  │  │  │  │  │  │建築│  │  │  │      │      │\n│    │號│            │        │        │  │  │  │  │  │  │  │  │  │  │  │  │    │  │  │單│範  圍│      │\n│    │  │            │        │房屋層數│  │  │  │  │  │  │  │  │  │  │  │計│材料│台│遮│位│      │      │\n├──┼─┼──────┼────┼────┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼──┼─┼─┼─┼───┼───┤\n│002 │54│台南市安平區│台南市安│14層樓房│24│  │  │  │  │  │  │  │  │  │  │24│    │  │  │  │10000 │      │\n│    │38│建平8街72號 │平區新南│管理員室│.2│  │  │  │  │  │  │  │  │  │  │.2│    │  │  │  │分之13│      │\n│    │  │            │段71-1地│鋼筋混凝│1 │  │  │  │  │  │  │  │  │  │  │1 │    │  │  │  │9     │      │\n│    │  │            │號      │土造    │  │  │  │  │  │  │  │  │  │  │  │  │    │  │  │  │      │      │\n├──┴─┴──────┴────┴────┴─┴─┴─┴─┴─┴─┴─┴─┴─┴─┴─┴─┴──┴─┴─┴─┴───┴───┤\n│ 含共同使用部分新南段5436建號，權利範圍：10000分之5375                                                                      │\n└──────────────────────────────────────────────────────────────┘\n",
