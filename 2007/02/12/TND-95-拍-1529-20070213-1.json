                         │\n└──────────────────────────────────────────────────────────────┘\n┌──────────────────────────────────────────────────────────────┐\n│附表（建物）︰                                                                                            95年度拍字第1529號│\n├──┬─┬──────┬────┬────┬───────────────────────┬────────┬───┬───┤\n│    │  │            │        │建築式樣│  建  物  面  積          （單位：平方公尺）  │附  屬    建  物│      │      │\n│    │建│            │        │        ├─┬─┬─┬─┬─┬─┬─┬─┬─┬─┬─┬─┼──┬─┬─┬─┤權  利│      │\n│    │  │            │        │主要建築│  │  │  │  │  │  │  │  │  │  │  │合│主要│陽│雨│面│      │      │\n│編號│  │  建物門牌  │基地坐落│        │十│  │  │  │  │  │  │  │  │  │  │  │    │  │  │積│      │備  考│\n│    │  │            │        │材 料 及│四│  │  │  │  │  │  │  │  │  │  │  │建築│  │  │  │      │      │\n│    │號│            │        │        │層│  │  │  │  │  │  │  │  │  │  │  │    │  │  │單│範  圍│      │\n│    │  │            │        │房屋層數│  │  │  │  │  │  │  │  │  │  │  │計│材料│台│遮│位│      │      │\n│    │  │            │        │        │  │  │  │  │  │  │  │  │  │  │  │  │    │  │  │  │      │      │\n│    │  │            │        │        │  │  │  │  │  │  │  │  │  │  │  │  │    │  │  │  │      │      │\n├──┼─┼──────┼────┼────┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼──┼─┼─┼─┼───┼───┤\n│002 │25│台南市安南區│台南市安│14層樓房│9.│  │  │  │  │  │  │  │  │  │  │9.│    │  │  │  │20000 │      │\n│    │69│郡安路4段278│南區溪頂│管理員室│75│  │  │  │  │  │  │  │  │  │  │75│    │  │  │  │分之35│      │\n│    │  │巷15弄2號   │段1257-7│鋼筋混凝│  │  │  │  │  │  │  │  │  │  │  │  │    │  │  │  │8     │      │\n│    │  │            │地號    │土造    │  │  │  │  │  │  │  │  │  │  │  │  │    │  │  │  │      │      │\n├──┴─┴──────┴────┴────┴─┴─┴─┴─┴─┴─┴─┴─┴─┴─┴─┴─┴──┴─┴─┴─┴───┴───┤\n│ 含共同使用部分溪頂段2639建號，權利範圍：10000分之7132                                                                      │\n└──────────────────────────────────────────────────────────────┘\n",
