───┼────┼────────┼─┼──┼──┼──────┼─────────┼──────┤\n│010 │嘉義縣│番路鄉  │公田    │        │55-93           │林│    │30  │90.00       │四十分之三        │            │\n├──┼───┼────┼────┼────┼────────┼─┼──┼──┼──────┼─────────┼──────┤\n│011 │嘉義縣│番路鄉  │公田    │        │55-114          │林│1   │82  │54.00       │四十分之三        │            │\n├──┼───┼────┼────┼────┼────────┼─┼──┼──┼──────┼─────────┼──────┤\n│012 │嘉義縣│番路鄉  │公田    │        │55-116          │林│    │    │49.00       │四十分之三        │            │\n└──┴───┴────┴────┴────┴────────┴─┴──┴──┴──────┴─────────┴──────┘\n",
