     ├─┬─┬─┬─┬─┬─┬─┬─┬─┬─┬─┬─┬─┼──┬─┬─┤權  利│      │\n│  │  │            │        │主要建築│地│二│三│四│五│六│七│八│九│十│十│十│合│主要│面│面│      │      │\n│  │  │  建物門牌  │基地坐落│        │  │  │  │  │  │  │  │  │  │  │一│二│  │建築│  │積│      │備  考│\n│  │  │            │        │材 料 及│面│  │  │  │  │  │  │  │  │  │  │  │  │材料│  │  │      │      │\n│號│號│            │        │        │  │  │  │  │  │  │  │  │  │  │  │  │  │及用│  │單│範  圍│      │\n│  │  │            │        │房屋層數│層│層│層│層│層│層│層│層│層│層│層│層│計│途  │積│位│      │      │\n│  │  │            │        │        │  │  │  │  │  │  │  │  │  │  │  │  │  │    │  │  │      │      │\n├─┼─┼──────┼────┼────┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼──┼─┼─┼───┼───┤\n│  │9 │新竹市○○段│新竹市林│住家用、│  │  │  │1 │  │  │  │  │  │  │  │  │1 │陽台│8 │平│全  部│所有權│\n│1 │4 │83-2、83-34 │森路302 │鋼筋混凝│  │  │  │1 │  │  │  │  │  │  │  │  │1 │    │. │方│      │人：林│\n│  │5 │83-36       │號4樓之1│土造、12│  │  │  │4 │  │  │  │  │  │  │  │  │4 │    │4 │公│      │郭來有│\n│  │  │            │        │層      │  │  │  │. │  │  │  │  │  │  │  │  │. │    │3 │尺│      │。共用│\n│  │  │            │        │        │  │  │  │8 │  │  │  │  │  │  │  │  │8 │    │  │  │      │部分：│\n│  │  │            │        │        │  │  │  │8 │  │  │  │  │  │  │  │  │8 │    │  │  │      │974建 │\n│  │  │            │        │        │  │  │  │  │  │  │  │  │  │  │  │  │  │    │  │  │      │號，權│\n│  │  │            │        │        │  │  │  │  │  │  │  │  │  │  │  │  │  │    │  │  │      │利範圍│\n│  │  │            │        │        │  │  │  │  │  │  │  │  │  │  │  │  │  │    │  │  │      │10000 │\n│  │  │            │        │        │  │  │  │  │  │  │  │  │  │  │  │  │  │    │  │  │      │分之  │\n│  │  │            │        │        │  │  │  │  │  │  │  │  │  │  │  │  │  │    │  │  │      │242。 │\n│  │  │            │        │        │  │  │  │  │  │  │  │  │  │  │  │  │  │    │  │  │      │975建 │\n│  │  │            │        │        │  │  │  │  │  │  │  │  │  │  │  │  │  │    │  │  │      │號，權│\n│  │  │            │        │        │  