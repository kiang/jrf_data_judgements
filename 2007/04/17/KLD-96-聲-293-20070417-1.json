│                │                │\n│最  後│案    號│95年訴字第710號 │                │                │\n│      │        │                │                │                │\n│事實審├────┼────────┼────────┼────────┤\n│      │        │                │                │                │\n│      │判決日期│    96.02.26    │                │                │\n│      │        │                │                │                │\n├───┼────┼────────┼────────┼────────┤\n│      │法    院│ 基  隆  地  院 │                │                │\n│      ├────┼────────┼────────┼────────┤\n│      │        │                │                │                │\n│確  定│案    號│95年訴字第710號 │                │                │\n│      │        │                │                │                │\n│判  決├────┼────────┼────────┼────────┤\n│      │判    決│                │                │                │\n│      │        │    96.03.26    │                │                │\n│      │確定日期│                │                │                │\n├───┴────┼────────┼────────┼────────┤\n│                │基隆地檢96年執字│                │                │\n│備            註│第804號         │                │                │\n│                │                │                │                │\n└────────┴────────┴────────┴────────┘\n",
