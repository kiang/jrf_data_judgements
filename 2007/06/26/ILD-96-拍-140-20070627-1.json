   │    │    │公尺，│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │權利範│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │圍1000│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │0分之 │\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │115。 │\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │2、羅 │\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │莊段67│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │9建號 │\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │，面積│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │46.25 │\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │平方公│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │尺，權│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │利範圍│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │10000 │\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │分之3 │\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │56。  │\n└─┴──┴────┴────┴────┴───┴───┴───┴───┴───┴───┴────┴───┴──┴──┴───┘\n",
