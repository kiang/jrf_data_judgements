├──┼──────┼──────┼──────┼───────┼─────┼──┤\n│018 │林信裕      │萬泰商業銀行│95年9月30日 │670元         │BP0000000 │    │\n│    │            │屏東分行    │            │              │          │    │\n├──┼──────┼──────┼──────┼───────┼─────┼──┤\n│019 │林信裕      │萬泰商業銀行│95年9月30日 │1,000元       │BP0000000 │    │\n│    │            │屏東分行    │            │              │          │    │\n├──┼──────┼──────┼──────┼───────┼─────┼──┤\n│020 │林信裕      │萬泰商業銀行│95年9月30日 │5,229元       │BP0000000 │    │\n│    │            │屏東分行    │            │              │          │    │\n├──┼──────┼──────┼──────┼───────┼─────┼──┤\n│021 │林信裕      │萬泰商業銀行│95年9月30日 │860元         │BP0000000 │    │\n│    │            │屏東分行    │            │              │          │    │\n├──┼──────┼──────┼──────┼───────┼─────┼──┤\n│022 │林信裕      │萬泰商業銀行│95年9月30日 │1,152元       │BP0000000 │    │\n│    │            │屏東分行    │            │              │          │    │\n├──┼──────┼──────┼──────┼───────┼─────┼──┤\n│023 │林信裕      │萬泰商業銀行│95年9月30日 │4,200元       │BP0000000 │    │\n│    │            │屏東分行    │            │              │          │    │\n└──┴──────┴──────┴──────┴───────┴─────┴──┘\n",
