│\n├───────────┼──────────┼──────────┤\n│犯  罪  日  期        │94年2月起至94年3月24│                    │\n│年    月    日        │日止                │                    │\n├───────────┼──────────┼──────────┤\n│偵查（自訴）機關      │臺中地檢94年度毒偵字│                    │\n│年   度   案  號      │第1918號            │                    │\n├─┬─────────┼──────────┼──────────┤\n│最│法        院      │臺中地院            │                    │\n│後├─────────┼──────────┼──────────┤\n│事│案        號      │94年度訴字第1519號  │                    │\n│實├─────────┼──────────┼──────────┤\n│審│判  決 日 期      │94年6月3日          │                    │\n├─┼─────────┼──────────┼──────────┤\n│確│法        院      │臺中地院            │                    │\n│定├─────────┼──────────┼──────────┤\n│判│案        號      │94年度訴字第1519號  │                    │\n│決├─────────┼──────────┼──────────┤\n│  │判決確定日期      │94.06.03            │                    │\n├─┴─────────┼──────────┼──────────┤\n│所犯法條              │毒品危害防制條例第  │                    │\n│                      │10條第1項           │                    │\n├───────────┼──────────┼──────────┤\n│合於96年罪犯減刑條例  │第2條第1項第3款     │                    │\n├───────────┼──────────┼──────────┤\n│減刑後徒刑、拘役或罰金│有期徒刑5月         │                    │\n│金額或褫奪公權期間    │                    │                    │\n├───────────┼──────────┼──────────┤\n│備註                  │臺中地檢94年度執更字│                    │\n│                      │第2200號            │                    │\n└───────────┴──────────┴──────────┘\n",
