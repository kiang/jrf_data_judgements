────┼────┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼────┼─┼─┼───┼───┤\n│  │６│新竹市○○路│新竹市古│住家用、│１│１│１│７│４│  │  │  │  │  │  │５│陽台    │６│平│全  部│      │\n│１│０│386巷100弄  │峰段711-│鋼筋混凝│９│０│０│８│７│  │  │  │  │  │  │３│        │２│方│      │      │\n│  │３│128 號      │24、736-│土造、4 │４│６│５│．│．│  │  │  │  │  │  │２│        │．│公│      │      │\n│  │  │            │2地號   │層      │．│．│．│０│７│  │  │  │  │  │  │．│        │８│尺│      │      │\n│  │  │            │        │        │７│２│４│９│３│  │  │  │  │  │  │３│        │７│  │      │      │\n│  │  │            │        │        │７│６│５│  │  │  │  │  │  │  │  │０│        │  │  │      │      │\n└─┴─┴──────┴────┴────┴─┴─┴─┴─┴─┴─┴─┴─┴─┴─┴─┴─┴────┴─┴─┴───┴───┘\n",
