│                  │\n├─────────┼─────────┼─────────┼─────────┼─────────┤\n│偵查（自訴）機關年│  台中地檢86年偵  │  台中地檢86年偵  │  台中地檢86年偵  │                  │\n│  度  案  號      │    字第2151號    │    字第2151號    │    字第2151號    │                  │\n├─┬───────┼─────────┼─────────┼─────────┼─────────┤\n│最│法          院│     台中地院     │    台中高分院    │    台中高分院    │                  │\n│後├───────┼─────────┼─────────┼─────────┼─────────┤\n│事│案          號│  86年訴字第670號 │87年上訴字第586號 │88年上更 (一)字第 │                  │\n│  │              │                  │                  │147 號            │                  │\n│實├───────┼─────────┼─────────┼─────────┼─────────┤\n│審│判  決  日  期│     86.11.17     │     87.12.04     │     88.08.18     │                  │\n├─┼───────┼─────────┼─────────┼─────────┼─────────┤\n│確│法          院│     台中地院     │    台中高分院    │    台中高分院    │                  │\n│定├───────┼─────────┼─────────┼─────────┼─────────┤\n│判│案          號│  86年訴字第670號 │87年上訴字第586號 │88年上更 (一)字第 │                  │\n│  │              │                  │                  │147號             │                  │\n│決├───────┼─────────┼─────────┼─────────┼─────────┤\n│  │判決確定日期  │     87.04.07     │     87.12.28     │     88.09.13     │                  │\n├─┴───────┼─────────┼─────────┼─────────┼─────────┤\n│所   犯   法   條 │刑法第346條第1項  │懲治盜匪條例第5條 │違反槍砲彈藥刀械管│                  │\n│                  │                  │第1項第1款        │制條例第7條第4項  │                  │\n├─────────┼─────────┼─────────┼─────────┼─────────┤\n│合於96年罪犯減刑條│  第2條第2項前段  │        不合      │  第2條第2項前段  │                  │\n│例                │                  │                  │                  │                  │\n├─────────┼─────────┼─────────┼─────────┼─────────┤\n│備              註│                  │                  │                  │                  │\n└─────────┴─────────┴─────────┴─────────┴─────────┘\n",
