 │      │      │      │      │      │        │      │    │    │利範圍│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │：1000│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │0分之6│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │14；壯│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │一段45│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │67建號│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │，面積│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │3737.8│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │平方公│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │尺，權│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │利範圍│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │：1000│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │0分之5│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │4     │\n└─┴──┴────┴────┴────┴───┴───┴───┴───┴───┴───┴────┴───┴──┴──┴───┘\n",
