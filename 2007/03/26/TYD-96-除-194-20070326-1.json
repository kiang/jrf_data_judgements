    │62,100元        │ＨＣ０三０七二七│    │\n│3 │                  │分行              │                      │                │一              │    │\n├─┼─────────┼─────────┼───────────┼────────┼────────┼──┤\n│01│李玉惠            │華南商業銀行  龜山│95年9月7日            │46,900元        │ＨＣ０三二０二０│    │\n│4 │                  │分行              │                      │                │三              │    │\n├─┼─────────┼─────────┼───────────┼────────┼────────┼──┤\n│01│李玉惠            │華南商業銀行  龜山│95年10月7日           │25,200元        │ＨＣ０三二０二三│    │\n│5 │                  │分行              │                      │                │六              │    │\n├─┼─────────┼─────────┼───────────┼────────┼────────┼──┤\n│01│江長青            │台灣中小企業銀行  │95年8月31日           │9,500元         │ＡＳ０六九０五六│    │\n│6 │                  │新明分行          │                      │                │二              │    │\n├─┼─────────┼─────────┼───────────┼────────┼────────┼──┤\n│01│江長青            │台灣中小企業銀行  │95年9月30日           │13,000元        │ＡＳ０七０八０二│    │\n│7 │                  │新明分行          │                      │                │九              │    │\n├─┼─────────┼─────────┼───────────┼────────┼────────┼──┤\n│01│江長青            │台灣中小企業銀行  │95年11月5日           │28,800元        │ＡＳ０七０八０三│    │\n│8 │                  │新明分行          │                      │                │０              │    │\n├─┼─────────┼─────────┼───────────┼────────┼────────┼──┤\n│01│大勝汽車材料有限公│華南商業銀行  中壢│95年9月7日            │71,500元        │ＳＣ０三一八三七│    │\n│9 │司                │分行              │                      │                │九              │    │\n├─┼─────────┼─────────┼───────────┼────────┼────────┼──┤\n│02│大勝汽車材料有限公│華南商業銀行  中壢│95年10月7日           │67,000元        │ＳＣ０三一八三八│    │\n│0 │司                │分行              │                      │                │０              │    │\n├─┼─────────┼─────────┼───────────┼────────┼────────┼──┤\n│02│大勝汽車材料有限公│華南商業銀行  中壢│95年11月7日           │38,400元        │ＳＣ０三一八三八│    │\n│1 │司                │分行             