  │      │      │      │      │      │        │      │    │    │方公尺│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │，權利│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │範圍10│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │000分 │\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │之72，│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │金六結│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │段六結│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │小段30│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │71建號│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │，面積│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │364.22│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │平方公│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │尺，權│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │利範圍│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │10000 │\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │分之42│\n└─┴──┴────┴────┴────┴───┴───┴───┴───┴───┴───┴────┴───┴──┴──┴───┘\n",
