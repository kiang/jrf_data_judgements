       │                    │\n├──────┼──────────┼──────────┼──────────┼──────────┤\n│宣告刑      │有期徒刑3 月        │有期徒刑6 月        │                    │                    │\n├──────┼──────────┼──────────┼──────────┼──────────┤\n│  犯 罪 日  │94年8 月23日        │94年8 月24日採尿時回│                    │                    │\n│  （民國）  │                    │溯96小時內某時      │                    │                    │\n├───┬──┼──────────┼──────────┼──────────┼──────────┤\n│偵查機│機關│臺灣桃園地方法院    │臺灣桃園地方法院    │                    │                    │\n│關及案│    │檢察署              │檢察署              │                    │                    │\n│號    ├──┼──────────┼──────────┼──────────┼──────────┤\n│      │案號│94年偵字第19438 號  │94年毒偵字第4861號  │                    │                    │\n├───┼──┼──────────┼──────────┼──────────┼──────────┤\n│最後事│法院│臺灣桃園地方法院    │臺灣桃園地方法院    │                    │                    │\n│實審  ├──┼──────────┼──────────┼──────────┼──────────┤\n│      │案號│94年壢簡字第2178號  │94年壢簡字第2060號  │                    │                    │\n│      ├──┼──────────┼──────────┼──────────┼──────────┤\n│      │判決│94年12月22日        │94年11月14日        │                    │                    │\n│      │日期│                    │                    │                    │                    │\n├───┼──┼──────────┼──────────┼──────────┼──────────┤\n│確定  │法院│臺灣桃園地方法院    │臺灣桃園地方法院    │                    │                    │\n│判決  ├──┼──────────┼──────────┼──────────┼──────────┤\n│      │案號│94年壢簡字第2178號  │94年壢簡字第2060號  │                    │                    │\n│      ├──┼──────────┼──────────┼──────────┼──────────┤\n│      │確定│95年1月21日         │95年1月25日         │                    │                    │\n│      │日期│                    │                    │                    │                    │\n├───┴──┼──────────┼──────────┼──────────┼──────────┤\n│合於中華民國│中華民國罪犯減刑條例│中華民國罪犯減刑條例│                    │                    │\n│九十六年罪犯│第2 條第1 項第3 款  │第2 條第1 項第3 款  │                    │           