  │\n├───┼────┼────────┼────────┼────────┤\n│      │法    院│      同上      │      同上      │                │\n│確  定├────┼────────┼────────┼────────┤\n│      │案    號│   94年度易字   │      同上      │                │\n│      │        │    第771號     │                │                │\n│判  決├────┼────────┼────────┼────────┤\n│      │判決確定│    94.9.26     │    94.9.26     │                │\n│      │日    期│                │                │                │\n├───┴────┼────────┼────────┼────────┤\n│ 所  犯  法  條 │  刑法第321條   │  刑法第216條   │                │\n├────────┼────────┼────────┼────────┤\n│ 合於 96 年罪犯 │第2條第1項第3款 │第2條第1項第3款 │                │\n│ 減  刑  條  例 │                │                │                │\n├────────┼────────┼────────┼────────┤\n│ 減刑後徒刑、拘 │                │                │                │\n│ 役或罰金金額或 │   有期徒刑7月  │   有期徒刑4月  │                │\n│  褫奪公權期間  │                │                │                │\n├────────┼────────┼────────┼────────┤\n│ 備          註 │    編號4、5    │       \"        │                │\n│                │   合數罪併罰   │                │                │\n└────────┴────────┴────────┴────────┘\n",
