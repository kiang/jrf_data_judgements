            │                          │\n├───────┼─────────────┼─────────────┼─────────────┤\n│偵查機關及案號│臺中地檢94年度偵字第8336號│臺中地檢94年度偵字第10274 │                          │\n│              │                          │號                        │                          │\n├───┬───┼─────────────┼─────────────┼─────────────┤\n│最後事│法  院│臺灣臺中地方法院          │臺灣高等法院臺中分院      │                          │\n│實審  ├───┼─────────────┼─────────────┼─────────────┤\n│      │案號  │94年度訴字第2089號        │95年度上訴字第909號       │                          │\n│      ├───┼─────────────┼─────────────┼─────────────┤\n│      │判決日│95年3月16日               │95年5月16日               │                          │\n│      │期    │                          │                          │                          │\n├───┼───┼─────────────┼─────────────┼─────────────┤\n│確定判│法院  │臺灣臺中地方法院          │臺灣高等法院臺中分院      │                          │\n│決    ├───┼─────────────┼─────────────┼─────────────┤\n│      │案號  │94年度訴字第2089號        │95年度上訴字第909號       │                          │\n│      ├───┼─────────────┼─────────────┼─────────────┤\n│      │判決確│95年4月14日               │95年6月9日                │                          │\n│      │定日期│                          │                          │                          │\n├───┴───┼─────────────┼─────────────┼─────────────┤\n│合於中華民國96│第2條第1項第3款           │第3條第1項第15款          │                          │\n│年罪犯減刑條例│                          │                          │                          │\n├───────┼─────────────┼─────────────┼─────────────┤\n│減刑刑期及易科│有期徒刑5月               │不予減刑                  │                          │\n│罰金之折算標準│                          │                          │                          │\n└───────┴─────────────┴─────────────┴─────────────┘\n",
