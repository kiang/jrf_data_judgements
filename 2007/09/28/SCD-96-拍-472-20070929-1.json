 │  │  │  │  │  │  │  │ 築材料 │  │  │      │      │\n│號│號│            │        │        │二│一│  │  │  │  │  │  │  │  │  │  │        │  │單│範  圍│      │\n│  │  │            │        │房屋層數│層│層│層│層│層│層│  │  │  │  │  │計│ 及用途 │積│位│      │      │\n├─┼─┼──────┼────┼────┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼────┼─┼─┼───┼───┤\n│  │５│新竹竹東鎮康│新竹縣竹│住家用、│  │  │４│４│４│１│  │  │  │  │  │１│一層陽台│１│平│全部  │      │\n│１│０│莊街107巷5號│東鎮九莊│鋼筋混凝│  │  │１│４│３│１│  │  │  │  │  │４│等四項  │３│方│      │      │\n│  │５│            │段787地 │土造、4 │  │  │．│．│．│．│  │  │  │  │  │１│        │．│公│      │      │\n│  │  │            │號      │層      │  │  │１│６│８│２│  │  │  │  │  │．│        │７│尺│      │      │\n│  │  │            │        │        │  │  │９│９│８│６│  │  │  │  │  │０│        │３│  │      │      │\n│  │  │            │        │        │  │  │  │  │  │  │  │  │  │  │  │２│        │  │  │      │      │\n├─┼─┼──────┼────┼────┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼────┼─┼─┼───┼───┤\n│  │７│新竹竹東鎮康│新竹縣竹│工業用、│１│１│１│  │  │  │  │  │  │  │  │３│        │  │平│100000│      │\n│２│２│莊街177號   │東鎮九莊│鋼筋混凝│８│７│２│  │  │  │  │  │  │  │  │７│        │  │方│分之43│      │\n│  │７│            │段396地 │土造、3 │５│７│．│  │  │  │  │  │  │  │  │５│        │  │公│9     │      │\n│  │  │            │號      │層      │．│．│５│  │  │  │  │  │  │  │  │．│        │  │尺│      │      │\n│  │  │            │        │        │３│６│７│  │  │  │  │  │  │  │  │５│        │  │  │      │      │\n│  │  │            │        │        │１│６│  │  │  │  │  │  │  │  │  │４│        │  │  │      │      │\n└─┴─┴──────┴────┴────┴─┴─┴─┴─┴─┴─┴─┴─┴─┴─┴─┴─┴────┴─┴─┴───┴───┘\n",
