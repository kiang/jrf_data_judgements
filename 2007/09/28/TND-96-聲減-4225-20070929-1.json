 │\n│            │、第4款               │                    │                    │                    │\n├──────┼───────────┼──────────┼──────────┼──────────┤\n│  犯罪日期  │93年6月初至94年1月24日│                    │                    │                    │\n├──────┼───────────┼──────────┼──────────┼──────────┤\n│  偵查機關  │同編號一              │                    │                    │                    │\n├──────┼───────────┼──────────┼──────────┼──────────┤\n│    案號    │94年度偵字第1701號、  │                    │                    │                    │\n│            │5006號、8089號        │                    │                    │                    │\n├─┬────┼───────────┼──────────┼──────────┼──────────┤\n│最│  法院  │同編號一              │                    │                    │                    │\n│後├────┼───────────┼──────────┼──────────┼──────────┤\n│事│  案號  │95年度易字第563號     │                    │                    │                    │\n│實├────┼───────────┼──────────┼──────────┼──────────┤\n│審│判決日期│96年4月27日           │                    │                    │                    │\n├─┼────┼───────────┼──────────┼──────────┼──────────┤\n│確│  法院  │同編號一              │                    │                    │                    │\n│定├────┼───────────┼──────────┼──────────┼──────────┤\n│判│  案號  │同上                  │                    │                    │                    │\n│決├────┼───────────┼──────────┼──────────┼──────────┤\n│  │確定日期│96年5月14日           │                    │                    │                    │\n├─┴────┼───────────┼──────────┼──────────┼──────────┤\n│  減刑刑期  │有期徒刑柒月又拾伍日。│                    │                    │                    │\n├──────┼───────────┼──────────┼──────────┼──────────┤\n│  備    註  │                      │                    │                    │                    │\n└──────┴───────────┴──────────┴──────────┴──────────┘\n",
