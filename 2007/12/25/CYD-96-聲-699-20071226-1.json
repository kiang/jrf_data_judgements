       │          │                │\n│    │ 申○○、亥○○、 │          │          │                │\n│    │ 戌○○、黃○○、 │          │          │                │\n│    │ 玄○○、酉○○   │          │          │                │\n│    │ 共27人           │          │          │                │\n│    │                  │          │          │                │\n├──┼─────────┼─────┼─────┼────────┤\n│ 14 │Ｄ○○、Ｃ○○、林│ 連帶負擔 │   3,180元│                │\n│    │鍵志、Ｂ○○、林榮│   1/32   │          │                │\n│    │居、Ｐ○○、翁陳麗│          │          │                │\n│    │勻、Ｔ○○、Ｒ○○│          │          │                │\n│    │、Ｏ○○、Ｈ○○、│          │          │                │\n│    │Ｋ○○○、宇○○、│          │          │                │\n│    │天○○、地○○、林│          │          │                │\n│    │政銘、Ｑ○○○、邱│          │          │                │\n│    │林鳳、Ｉ○○○、林│          │          │                │\n│    │修全、申○○、林威│          │          │                │\n│    │宇、戌○○、黃○○│          │          │                │\n│    │、玄○○、酉○○  │          │          │                │\n│    │共26人            │          │          │                │\n├──┼─────────┼─────┼─────┼────────┤\n│ 15 │ 戊○○           │   1/72   │   1,413元│                │\n├──┼─────────┼─────┼─────┼────────┤\n│ 16 │ 己○○           │   1/72   │   1,413元│                │\n├──┼─────────┼─────┼─────┼────────┤\n│ 17 │ 壬○○           │   1/72   │   1,413元│                │\n├──┼─────────┼─────┼─────┼────────┤\n│ 18 │ 庚○○           │   1/72   │   1,413元│                │\n├──┼─────────┼─────┼─────┼────────┤\n│ 19 │ 子○○           │   1/72   │   1,413元│                │\n├──┼─────────┼─────┼─────┼────────┤\n│ 20 │ 寅○○           │   1/72   │   1,413元│                │\n├──┼─────────┼─────┼─────┼────────┤\n│ 21 │ 丑○○           │   1/72   │   1,413元│                │\n├──┼─────────┼─────┼─────┼────────┤\n│ 22 │ 乙○○           │   1/72   │   1,413元│                │\n├──┼─────────┼─────┼─────┼────────┤\n│ 23 │ Ｕ○○           │   1/72   │   1,413元│    