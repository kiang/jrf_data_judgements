│                    │\n│年   度   案  號      │5350號              │                    │                    │\n├─┬─────────┼──────────┼──────────┼──────────┤\n│最│法        院      │台中高分院          │                    │                    │\n│後├─────────┼──────────┼──────────┼──────────┤\n│事│案        號      │91年上訴字第692號   │                    │                    │\n│實├─────────┼──────────┼──────────┼──────────┤\n│審│判  決 日 期      │91年7月18日         │                    │                    │\n├─┼─────────┼──────────┼──────────┼──────────┤\n│確│法        院      │ 台中高分院         │                    │                    │\n│定├─────────┼──────────┼──────────┼──────────┤\n│判│案        號      │91年上訴字第692號   │                    │                    │\n│決├─────────┼──────────┼──────────┼──────────┤\n│  │判決確定日期      │91年8月9日          │                    │                    │\n├─┴─────────┼──────────┼──────────┼──────────┤\n│所犯法條              │刑法第325條第1項    │                    │                    │\n├───────────┼──────────┼──────────┼──────────┤\n│合於96年罪犯減刑條例  │第2條第2項前段      │                    │                    │\n├───────────┼──────────┼──────────┼──────────┤\n│備註                  │                    │                    │                    │\n└───────────┴──────────┴──────────┴──────────┘\n",
