               │\n├───────────┼──────────┼──────────┼──────────┤\n│視為減刑後之刑期      │有期徒刑7月         │                    │                    │\n│                      │併科罰金伍仟元      │                    │                    │\n├───────────┼──────────┼──────────┼──────────┤\n│犯   罪   日  期      │89.6.7月間至91.07.15│                    │                    │\n│年      月    日      │止                  │                    │                    │\n├───────────┼──────────┼──────────┼──────────┤\n│偵查（自訴）機關      │彰化地檢91年偵字第  │                    │                    │\n│年   度   案  號      │4632號              │                    │                    │\n├─┬─────────┼──────────┼──────────┼──────────┤\n│最│法        院      │台中高分院          │                    │                    │\n│後├─────────┼──────────┼──────────┼──────────┤\n│事│案        號      │93年上訴字第43號    │                    │                    │\n│實├─────────┼──────────┼──────────┼──────────┤\n│審│判  決 日 期      │93.05.13            │                    │                    │\n├─┼─────────┼──────────┼──────────┼──────────┤\n│確│法        院      │台中高分院          │                    │                    │\n│定├─────────┼──────────┼──────────┼──────────┤\n│判│案        號      │93年上訴字第43號    │                    │                    │\n│決├─────────┼──────────┼──────────┼──────────┤\n│  │判決確定日期      │93.06.07            │                    │                    │\n├─┴─────────┼──────────┼──────────┼──────────┤\n│所犯法條              │違反槍砲彈藥刀械管制│                    │                    │\n│                      │條例第12條第1項     │                    │                    │\n├───────────┼──────────┼──────────┼──────────┤\n│合於96年罪犯減刑條例  │第2條第2項前段      │                    │                    │\n├───────────┼──────────┼──────────┼──────────┤\n│備註                  │                    │                    │                    │\n└───────────┴──────────┴──────────┴──────────┘\n",
