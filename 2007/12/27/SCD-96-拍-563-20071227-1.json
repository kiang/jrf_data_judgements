 │  │號          │地號    │、2層   │．│．│  │  │  │  │  │  │  │  │  │５│        │  │公│      │      │\n│  │  │            │        │        │８│８│  │  │  │  │  │  │  │  │  │．│        │  │尺│      │      │\n│  │  │            │        │        │  │  │  │  │  │  │  │  │  │  │  │６│        │  │  │      │      │\n│  │  │            │        │        │  │  │  │  │  │  │  │  │  │  │  │  │        │  │  │      │      │\n│  │  │            │        │        │  │  │  │  │  │  │  │  │  │  │  │  │        │  │  │      │      │\n├─┼─┼──────┼────┼────┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼─┼────┼─┼─┼───┼───┤\n│２│３│新竹縣湖口鄉○○○段  │住家用、│７│  │  │  │  │  │  │  │  │  │  │７│        │  │平│全部  │      │\n│  │７│八德路1段696│492、493│加強磚造│２│  │  │  │  │  │  │  │  │  │  │２│        │  │方│      │      │\n│  │  │號          │地號    │、1層   │．│  │  │  │  │  │  │  │  │  │  │．│        │  │公│      │      │\n│  │  │            │        │        │７│  │  │  │  │  │  │  │  │  │  │７│        │  │尺│      │      │\n│  │  │            │        │        │５│  │  │  │  │  │  │  │  │  │  │５│        │  │  │      │      │\n│  │  │            │        │        │  │  │  │  │  │  │  │  │  │  │  │  │        │  │  │      │      │\n│  │  │            │        │        │  │  │  │  │  │  │  │  │  │  │  │  │        │  │  │      │      │\n└─┴─┴──────┴────┴────┴─┴─┴─┴─┴─┴─┴─┴─┴─┴─┴─┴─┴────┴─┴─┴───┴───┘\n",
