  期        │86年3月10日         │                    │\n│年    月    日        │                    │                    │\n├───────────┼──────────┼──────────┤\n│偵查（自訴）機關      │臺中地檢86年偵字第  │                    │\n│年   度   案  號      │6038號              │                    │\n├─┬─────────┼──────────┼──────────┤\n│最│法        院      │臺中高分院          │                    │\n│後├─────────┼──────────┼──────────┤\n│事│案        號      │86年上訴字第1418號  │                    │\n│實├─────────┼──────────┼──────────┤\n│審│判  決 日 期      │87年7月7日          │                    │\n├─┼─────────┼──────────┼──────────┤\n│確│法        院      │最高法院            │                    │\n│定├─────────┼──────────┼──────────┤\n│判│案        號      │88年台上字第1621號  │                    │\n│決├─────────┼──────────┼──────────┤\n│  │判決確定日期      │88年4月1日          │                    │\n├─┴─────────┼──────────┼──────────┤\n│所犯法條              │刑法第271條第2項第1 │                    │\n│                      │項                  │                    │\n├───────────┼──────────┼──────────┤\n│合於96年罪犯減刑條例  │不合                │                    │\n├───────────┼──────────┼──────────┤\n│備註                  │                    │                    │\n└───────────┴──────────┴──────────┘\n",
