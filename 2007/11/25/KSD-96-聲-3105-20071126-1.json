號 │字第2064號        │                  │\n├───┬──┼─────────┼─────────┤\n│      │法院│高雄地院          │                  │\n│      ├──┼─────────┼─────────┤\n│最  後│案號│96年度易字第1565號│                  │\n│      │    │                  │                  │\n│事實審├──┼─────────┼─────────┤\n│      │判決│96年7月25日       │                  │\n│      │日期│                  │                  │\n├───┼──┼─────────┼─────────┤\n│      │法院│高雄地院          │                  │\n│確  定├──┼─────────┼─────────┤\n│      │案號│96年度易字第1565號│                  │\n│      │    │                  │                  │\n│判  決├──┼─────────┼─────────┤\n│      │確定│96年8月20日       │                  │\n│      │日期│                  │                  │\n├───┴──┼─────────┼─────────┤\n│備        考│高雄地檢96年度執字│                  │\n│            │第14113號（與編號3│                  │\n│            │、4所示之罪曾定應 │                  │\n│            │執行有期徒刑5月） │                  │\n└──────┴─────────┴─────────┘\n",
