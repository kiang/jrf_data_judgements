  │                      │\n│機關及案號  ├───────────┼───────────┼───────────┤\n│            │82年偵字第3376號      │                      │                      │\n├─┬────┼───────────┼───────────┼───────────┤\n│最│法    院│臺灣彰化地方法院      │                      │                      │\n│後├────┼───────────┼───────────┼───────────┤\n│事│案    號│81年度易字第1462號    │                      │                      │\n│實├────┼───────────┼───────────┼───────────┤\n│審│判決日期│82年6月11日           │                      │                      │\n├─┼────┼───────────┼───────────┼───────────┤\n│確│法    院│臺灣彰化地方法院      │                      │                      │\n│定├────┼───────────┼───────────┼───────────┤\n│判│案    號│81年度易字第1462號    │                      │                      │\n│決├────┼───────────┼───────────┼───────────┤\n│  │確定日期│82年7月16日           │                      │                      │\n├─┴────┼───────────┼───────────┼───────────┤\n│所犯法條    │麻醉藥品管理條例第13條│                      │                      │\n│            │之1第2項第4款         │                      │                      │\n├──────┼───────────┼───────────┼───────────┤\n│合於96年罪犯│第2條第2項前段        │                      │                      │\n│減刑條例    │                      │                      │                      │\n├──────┼───────────┼───────────┼───────────┤\n│備註        │                      │                      │                      │\n└──────┴───────────┴───────────┴───────────┘\n",
