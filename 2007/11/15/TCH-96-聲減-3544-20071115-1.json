       │82.6.28起至82.7.1止 │\n│                      │日止                │                    │                    │\n├───────────┼──────────┼──────────┼──────────┤\n│偵查（自訴）機關      │台中地檢82年度偵字第│台中地檢82年度偵字第│台中地檢82年度偵字第│\n│                      │12108、12452號      │12108、12452號      │12108、12452號      │\n├─┬─────────┼──────────┼──────────┼──────────┤\n│最│法        院      │台中高分院          │ 台中高分院         │台中高分院          │\n│後├─────────┼──────────┼──────────┼──────────┤\n│事│案        號      │82年上訴字第3982號  │82年上訴字第3982號  │82年上訴字第3982號  │\n│實├─────────┼──────────┼──────────┼──────────┤\n│審│判  決 日 期      │83.10.6             │83.10.6             │83.10.6             │\n├─┼─────────┼──────────┼──────────┼──────────┤\n│確│法        院      │   台中高分院       │  台中高分院        │台中高分院          │\n│定├─────────┼──────────┼──────────┼──────────┤\n│判│案        號      │82年上訴字第3982號  │82年上訴字第3982號  │82年度上訴字第3982號│\n│決├─────────┼──────────┼──────────┼──────────┤\n│  │判決確定日期      │83.11.12            │83.11.12            │83.11.12            │\n├─┴─────────┼──────────┼──────────┼──────────┤\n│所犯法條              │87.5.20修正公布前之 │刑法第349條第2項    │修正前槍砲彈藥刀械管│\n│                      │肅清煙毒條例第5條第1│                    │制條例第10條第3項   │\n│                      │項                  │                    │                    │\n├───────────┼──────────┼──────────┼──────────┤\n│合於96年罪犯減刑條例  │不合                │第2條第1項第3款     │第2條第1項第3款     │\n│條例                  │                    │                    │                    │\n├───────────┼──────────┼──────────┼──────────┤\n│減刑後徒刑、拘役或罰金│不予減刑            │有期徒刑1月又15日   │有期徒刑3月15日     │\n│額或或褫奪公權期間    │                    │                    │                    │\n├───────────┼──────────┼──────────┼──────────┤\n│備註                  │                    │                    │                    │\n└───────────┴──────────┴──────────┴──────────┘\n",
