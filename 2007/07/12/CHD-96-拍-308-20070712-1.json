                計 │及用途    │    │                  │\n├──┼───┼───────┼───────┼───────┼───────────┼─────┼──┼─────────┤\n│001 │38    │彰化縣埔心鄉明│彰化縣埔心鄉太│鐵造平房      │地面層：362.40；合計：│          │全部│一、重測前：太平段│\n│    │      │聖路2段408巷63│平東段84地號  │              │362.40                │          │    │    128建號。     │\n│    │      │號            │              │              │                      │          │    │二、丙○○所有。  │\n├──┼───┼───────┼───────┼───────┼───────────┼─────┼──┼─────────┤\n│001 │39    │彰化縣埔心鄉明│彰化縣埔心鄉太│鋼造平房      │地面層：290.38；合計：│          │全部│一、重測前：太平段│\n│    │      │聖路2段408巷79│平東段85、86、│              │290.38                │          │    │    423建號。     │\n│    │      │號            │87地號        │              │                      │          │    │二、丁○○所有。  │\n└──┴───┴───────┴───────┴───────┴───────────┴─────┴──┴─────────┘\n",
