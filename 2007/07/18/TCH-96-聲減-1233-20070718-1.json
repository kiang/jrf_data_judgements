    │                    │\n├───────────┼──────────┼──────────┼──────────┤\n│犯   罪   日  期      │86.04.01起          │                    │                    │\n│ 年     月   日       │至86.11.06止        │                    │                    │\n├───────────┼──────────┼──────────┼──────────┤\n│偵查（自訴）機關      │台中地檢86年偵字第  │                    │                    │\n│年 度 及 案 號        │23126號             │                    │                    │\n├─┬─────────┼──────────┼──────────┼──────────┤\n│最│法        院      │台中高分院          │                    │                    │\n│後├─────────┼──────────┼──────────┼──────────┤\n│事│案        號      │87年上訴字第440號   │                    │                    │\n│實├─────────┼──────────┼──────────┼──────────┤\n│審│判  決 日 期      │87.04.22            │                    │                    │\n├─┼─────────┼──────────┼──────────┼──────────┤\n│確│法        院      │台中高分院          │                    │                    │\n│定├─────────┼──────────┼──────────┼──────────┤\n│判│案        號      │87年上訴字第440號   │                    │                    │\n│決├─────────┼──────────┼──────────┼──────────┤\n│  │判決確定日期      │87.04.22            │                    │                    │\n├─┴─────────┼──────────┼──────────┼──────────┤\n│所犯法條              │ 麻醉藥品管理條例第 │                    │                    │\n│                      │ 13條之1第2項第4款  │                    │                    │\n├───────────┼──────────┼──────────┼──────────┤\n│合於96年罪犯減刑條例  │第2條第1項第3款     │                    │                    │\n├───────────┼──────────┼──────────┼──────────┤\n│減刑後徒刑、拘役或罰金│3月又15日           │                    │                    │\n│額或褫奪公權期間      │                    │                    │                    │\n├───────────┼──────────┼──────────┼──────────┤\n│備註                  │                    │                    │                    │\n└───────────┴──────────┴──────────┴──────────┘\n",
