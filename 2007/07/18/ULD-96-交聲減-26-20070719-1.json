├────┼──────────┼──────────┼─────────┼─────────┼─────────┤\n│      │  │日      │18                  │18                  │18                │14                │11                │\n├───┼─┴────┼──────────┼──────────┼─────────┼─────────┼─────────┤\n│      │法  院      │臺灣彰化地方法院    │臺灣彰化地方法院    │臺灣彰化地方法院  │臺灣雲林地方法院  │臺灣雲林地方法院  │\n│      ├─┬────┼──────────┼──────────┼─────────┼─────────┼─────────┤\n│      │  │年      │94                  │94                  │94                │94                │95                │\n│  確  │案├────┼──────────┼──────────┼─────────┼─────────┼─────────┤\n│      │  │月      │訴                  │訴                  │訴                │港交簡            │港交簡            │\n│  定  │號├────┼──────────┼──────────┼─────────┼─────────┼─────────┤\n│      │  │日      │1759                │1759                │1759              │78                │223               │\n│  日  ├─┼────┼──────────┼──────────┼─────────┼─────────┼─────────┤\n│      │確│年      │94                  │94                  │94                │94                │96                │\n│  期  │定├────┼──────────┼──────────┼─────────┼─────────┼─────────┤\n│      │日│月      │2                   │2                   │2                 │7                 │2                 │\n│      │期├────┼──────────┼──────────┼─────────┼─────────┼─────────┤\n│      │  │日      │14                  │14                  │14                │18                │7                 │\n├───┴─┴────┼──────────┼──────────┼─────────┼─────────┼─────────┤\n│合於九十六年罪犯減刑│第2 條第1 項第3 款  │第2 條第1 項第3 款  │第2 條第1 項第3 款│第2 條第1 項第3 款│第2 條第1 項第3 款│\n│條例                │                    │                    │                  │                  │                  │\n├──────────┼──────────┼──────────┼─────────┼─────────┼─────────┤\n│減刑後刑期          │有期徒刑6月         │有期徒刑4月         │有期徒刑3月       │有期徒刑3月       │拘役20日          │\n├──────────┼──────────┼──────────┼─────────┼─────────┼─────────┤\n│ 附         註      │                    │                 