             │\n├───┬───┼─────────────┼─────────────┤\n│最後事│法院  │  臺灣板橋地方法院        │                          │\n│實審  ├───┼─────────────┼─────────────┤\n│      │案號  │臺灣板橋地方法院96年度訴字│                          │\n│      │      │第385號                   │                          │\n│      ├───┼─────────────┼─────────────┤\n│      │判決日│   96年3月30日            │                          │\n│      │期    │                          │                          │\n├───┼───┼─────────────┼─────────────┤\n│確定判│法  院│  臺灣板橋地方法院        │                          │\n│決    ├───┼─────────────┼─────────────┤\n│      │案號  │臺灣板橋地方法院96年度訴字│                          │\n│      │      │第385號                   │                          │\n│      ├───┼─────────────┼─────────────┤\n│      │判決確│   96年5月3日             │                          │\n│      │定日期│                          │                          │\n├───┴───┼─────────────┼─────────────┤\n│合於中華民國九│  第2條第1項第3款         │                          │\n│十六年罪犯減刑│                          │                          │\n│條例          │                          │                          │\n├───────┼─────────────┼─────────────┤\n│減刑後刑期    │  有期徒刑3月15日         │                          │\n├───────┼─────────────┼─────────────┤\n│ 附         註│                          │                          │\n└───────┴─────────────┴─────────────┘\n",
