│\n │  日  ├─┼─┼─────────────┼─────────────┤\n │      │確│年│94                        │                          │\n │  期  │定├─┼─────────────┼─────────────┤\n │      │日│月│ 1                        │                          │\n │      │期├─┼─────────────┼─────────────┤\n │      │  │日│ 6                        │                          │\n ├───┴─┴─┼─────────────┼─────────────┤\n │合於中華民國九│第2條第1項第3款           │                          │\n │十六年罪犯減刑│                          │                          │\n │條例          │                          │                          │\n ├───────┼─────────────┼─────────────┤\n │減刑刑期褫奪公│減刑為有期徒刑五月        │                          │\n │權期間或罰金額│                          │                          │\n ├───────┼─────────────┼─────────────┤\n │ 附         註│                          │                          │\n └───────┴─────────────┴─────────────┘\n",
