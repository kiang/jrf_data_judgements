          │\n │  定  │號├─┼─────────────┼─────────────┤\n │      │  │號│1705                      │1705                      │\n │  日  ├─┼─┼─────────────┼─────────────┤\n │      │確│年│86                        │83                        │\n │  期  │定├─┼─────────────┼─────────────┤\n │      │日│月│10                        │6                         │\n │      │期├─┼─────────────┼─────────────┤\n │      │  │日│21                        │14                        │\n ├───┴─┴─┼─────────────┼─────────────┤\n │合於中華民國九│不得減刑                  │第2條第1項第3款           │\n │十六年罪犯減刑│                          │                          │\n │條例          │                          │                          │\n ├───────┼─────────────┼─────────────┤\n │減刑刑期褫奪公│                          │減為有期徒刑一年八月，褫奪│\n │權期間或罰金額│                          │公權一年六月              │\n ├───────┼─────────────┼─────────────┤\n │ 附         註│                          │                          │\n └───────┴─────────────┴─────────────┘\n",
