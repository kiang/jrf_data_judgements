                │\n├───────┼─────────────┼─────────────┤\n│  宣  告  刑  │拘役55日                  │                          │\n├───────┼─────────────┼─────────────┤\n│  所 犯 法 條 │刑法214條                 │                          │\n├───────┼─────────────┼─────────────┤\n│  犯 罪 日 期 │94年11月17日              │                          │\n├───┬───┼─────────────┼─────────────┤\n│偵    │機  關│台南地方法院檢察署        │                          │\n│    及├───┼─────────────┼─────────────┤\n│查    │  年  │96                        │                          │\n│    案├───┼─────────────┼─────────────┤\n│年    │  字  │偵                        │                          │\n│    號├───┼─────────────┼─────────────┤\n│度    │  號  │2404                      │                          │\n├───┼───┼─────────────┼─────────────┤\n│      │法  院│台南地方法院              │                          │\n│      ├─┬─┼─────────────┼─────────────┤\n│  最  │  │年│96                        │                          │\n│      │案├─┼─────────────┼─────────────┤\n│  後  │  │字│簡                        │                          │\n│      │號├─┼─────────────┼─────────────┤\n│  事  │  │號│580                       │                          │\n│      ├─┼─┼─────────────┼─────────────┤\n│  實  │判│年│96                        │                          │\n│      │決├─┼─────────────┼─────────────┤\n│  審  │日│月│3                         │                          │\n│      │期├─┼─────────────┼─────────────┤\n│      │  │日│27                        │                          │\n├───┼─┴─┼─────────────┼─────────────┤\n│      │法  院│台南地方法院              │                          │\n│      ├─┬─┼─────────────┼─────────────┤\n│      │  │年│96                        │                          │\n│  確  │案├─┼─────────────┼─────────────┤\n│      │  │字│簡                        │                          │\n│  定  │號├─┼─────────────┼─────────────┤\n│      │  │日│580                       │                          │\n│  日  ├─┼─┼─────────────┼─────────────┤\n│      │