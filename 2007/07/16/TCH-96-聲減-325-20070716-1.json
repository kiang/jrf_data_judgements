    │\n │      ├─┬─┼─────────────┼─────────────┼─────────────┼─────────────┤\n │      │  │年│          91              │            91            │           91             │                          │\n │  確  │案├─┼─────────────┼─────────────┼─────────────┼─────────────┤\n │      │  │字│         上訴             │           上訴           │         台上             │                          │\n │  定  │號├─┼─────────────┼─────────────┼─────────────┼─────────────┤\n │      │  │號│         549              │           549            │         4791             │                          │\n │  判  ├─┼─┼─────────────┼─────────────┼─────────────┼─────────────┤\n │      │確│年│          91              │            91            │          91              │                          │\n │  決  │定├─┼─────────────┼─────────────┼─────────────┼─────────────┤\n │      │日│月│          05              │            05            │          08              │                          │\n │      │期├─┼─────────────┼─────────────┼─────────────┼─────────────┤\n │      │  │日│          31              │            31            │          29              │                          │\n ├───┴─┴─┼─────────────┼─────────────┼─────────────┼─────────────┤\n │合於中華民國九│      第2條第1項第3款     │     第3條第1項第15款     │      第3條第1項第15款    │     第  條第  項第  款   │\n │十六年罪犯減刑│                          │                          │                          │                          │\n │條例          │                          │                          │                          │                          │\n ├───────┼─────────────┼─────────────┼─────────────┼─────────────┤\n │減刑後刑期褫奪│                          │                          │                          │                          │\n │公權期間或罰金│      有期徒刑6月         │          不合            │         不合             │                          │\n │額            │                          │                          │                          │                          │\n ├───────┼─────────────┼─────────────┼─────────────┼─────────────┤\n │ 附         註│                          │                          │                          │                          │\n └───────┴─────────────┴─────────────┴─────────────┴─────────────┘\n",
