┐\n │  編      號  │            3             │            4             │\n ├───────┼─────────────┼─────────────┤\n │  罪      名  │連續吸用化學合成麻醉藥品  │連續販賣化學合成麻醉藥品  │\n ├───────┼─────────────┼─────────────┤\n │  宣  告  刑  │有期徒刑五月              │有期徒刑五年二月          │\n ├───────┼─────────────┼─────────────┤\n │  所 犯 法 條 │麻醉藥品管理條例第13條之1 │麻醉藥品管理條例第13條之1 │\n │              │第2項第4款                │第2項第1款                │\n ├───────┼─────────────┼─────────────┤\n │  犯 罪 日 期 │82年7月9日                │81年7月                   │\n ├───┬───┼─────────────┼─────────────┤\n │偵    │機  關│臺灣板橋地方法院檢察署    │臺灣板橋地方法院檢察署    │\n │    及├───┼─────────────┼─────────────┤\n │查    │  年  │82                        │82                        │\n │    案├───┼─────────────┼─────────────┤\n │年    │  字  │偵                        │偵                        │\n │    號├───┼─────────────┼─────────────┤\n │度    │  號  │11852                     │11852                     │\n ├───┼───┼─────────────┼─────────────┤\n │      │法  院│臺灣板橋地方法院          │臺灣板橋地方法院          │\n │      ├─┬─┼─────────────┼─────────────┤\n │  最  │  │年│82                        │82                        │\n │      │案├─┼─────────────┼─────────────┤\n │  後  │  │字│訴                        │訴                        │\n │      │號├─┼─────────────┼─────────────┤\n │  事  │  │號│1864                      │1864                      │\n │      ├─┼─┼─────────────┼─────────────┤\n │  實  │判│年│82                        │82                        │\n │      │決├─┼─────────────┼─────────────┤\n │  審  │日│月│11                        │11                        │\n │      │期├─┼─────────────┼─────────────┤\n │      │  │日│ 8                        │ 8                        │\n ├───┼─┴─┼─────────────┼─────────────┤\n │      │法  院│臺灣板橋地方法院          │臺灣板橋地方法院          │\n │      ├─┬─┼─────────────┼─────────────┤\n │      │  │年│82                        │82                        │\n │  確  │案├─┼─────────────┼─────────────┤\n │      │  │字│訴                        │訴             