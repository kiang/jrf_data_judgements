       │           傷害           │\n├───────┼─────────────┼─────────────┤\n│  宣  告  刑  │      有期徒刑六月        │        有期徒刑一年      │\n├───────┼─────────────┼─────────────┤\n│  所 犯 法 條 │槍砲彈藥刀械管制條例第12條│     刑法第277條第1項     │\n│              │第1項                     │                          │\n├───────┼─────────────┼─────────────┤\n│  犯 罪 日 期 │   83年10月至84年10月間   │       88年10月24日       │\n├───┬───┼─────────────┼─────────────┤\n│偵    │機  關│ 臺灣新竹地方法院檢察署   │ 臺灣新竹地方法院檢察署   │\n│    及├───┼─────────────┼─────────────┤\n│查    │  年  │           88             │            88            │\n│    案├───┼─────────────┼─────────────┤\n│年    │  字  │           偵             │            偵            │\n│    號├───┼─────────────┼─────────────┤\n│度    │  號  │          7708            │           7708           │\n├───┼───┼─────────────┼─────────────┤\n│      │法  院│    臺灣新竹地方法院      │      臺灣高等法院        │\n│      ├─┬─┼─────────────┼─────────────┤\n│  最  │  │年│           89             │            90            │\n│      │案├─┼─────────────┼─────────────┤\n│  後  │  │字│           訴             │           上易           │\n│      │號├─┼─────────────┼─────────────┤\n│  事  │  │號│          449             │           1102           │\n│      ├─┼─┼─────────────┼─────────────┤\n│  實  │判│年│           89             │            90            │\n│      │決├─┼─────────────┼─────────────┤\n│  審  │日│月│           12             │            6             │\n│      │期├─┼─────────────┼─────────────┤\n│      │  │日│           27             │            15            │\n├───┼─┴─┼─────────────┼─────────────┤\n│      │法  院│    臺灣新竹地方法院      │      臺灣高等法院        │\n│      ├─┬─┼─────────────┼─────────────┤\n│      │  │年│           89             │            90            │\n│  確  │案├─┼─────────────┼─────────────┤\n│      │  │字│           訴             │           上易           │\n│  定  │號├─┼─────────────┼─────────────┤\n│      │  │號│          449             │           1102           │\n│  日  ├─┼─┼─────────────┼──