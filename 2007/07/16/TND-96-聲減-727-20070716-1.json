       │      82      │      81        │      81        │\n│  確  │案├─┼───────┼───────┼───────┼────────┼────────┤\n│      │  │月│     訴       │     訴       │      訴      │      訴        │      訴        │\n│  定  │號├─┼───────┼───────┼───────┼────────┼────────┤\n│      │  │日│    793       │    793       │     793      │     1871       │     1871       │\n│  日  ├─┼─┼───────┼───────┼───────┼────────┼────────┤\n│      │確│年│     83       │     83       │      83      │      82        │      82        │\n│  期  │定├─┼───────┼───────┼───────┼────────┼────────┤\n│      │日│月│     05       │     05       │      05      │      10        │      10        │\n│      │期├─┼───────┼───────┼───────┼────────┼────────┤\n│      │  │日│     10       │     10       │      10      │      20        │      20        │\n├───┴─┴─┼───────┼───────┼───────┼────────┼────────┤\n│合於中華民國九│              │              │              │                │                │\n│十六年罪犯減刑│第3條第1項第7 │第2條第1項第3 │第2條第1項第3 │第2條第1項第3款 │第3條第1項第18款│\n│條例          │款            │款            │款            │                │                │\n├───────┼───────┼───────┼───────┼────────┼────────┤\n│減刑刑期褫奪公│有期徒刑壹年玖│ 有期徒刑玖月 │有期徒刑伍月  │有期徒刑月又拾│   不應減刑     │\n│權期間或罰金額│月            │              │              │伍日            │                │\n├───────┼───────┼───────┼───────┼────────┼────────┤\n│ 附         註│              │              │              │                │                │\n└───────┴───────┴───────┴───────┴────────┴────────┘\n",
