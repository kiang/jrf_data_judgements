  │94                      │94                      │94                    │\n│  確  │案├─┼───────────┼────────────┼────────────┼───────────┤\n│      │  │字│易                    │訴                      │訴                      │桃簡                  │\n│  定  │號├─┼───────────┼────────────┼────────────┼───────────┤\n│      │  │號│117                   │536                     │536                     │716                   │\n│  日  ├─┼─┼───────────┼────────────┼────────────┼───────────┤\n│      │確│年│94                    │94                      │94                      │94                    │\n│  期  │定├─┼───────────┼────────────┼────────────┼───────────┤\n│      │日│月│5                     │7                       │7                       │6                     │\n│      │期├─┼───────────┼────────────┼────────────┼───────────┤\n│      │  │日│23                    │18                      │18                      │2                     │\n├───┴─┴─┼───────────┼────────────┼────────────┼───────────┤\n│合於中華民國九│第2條1項3款           │第2條1項3款             │第2條1項3款             │第2條1項3款           │\n│十六年罪犯減刑│                      │                        │                        │                      │\n│條例          │                      │                        │                        │                      │\n├───────┼───────────┼────────────┼────────────┼───────────┤\n│減刑刑期褫奪公│有期徒刑5月           │有期徒刑7月             │有期徒刑5月             │罰金銀元1,500元即新臺 │\n│權期間或罰金額│                      │                        │                        │幣4,500元             │\n├───────┼───────────┼────────────┼────────────┼───────────┤\n│易科罰金      │不得易科罰金          │不得易科罰金            │不得易科罰金            │如易服勞役以銀元300 元│\n│易服勞役      │                      │                        │                        │即新臺幣900 元折算1 日│\n└───────┴───────────┴────────────┴────────────┴───────────┘\n",
