   │                    │                    │\n├───────────┼──────────┼──────────┼──────────┤\n│宣     告     刑      │                    │                    │                    │\n├───────────┼──────────┼──────────┼──────────┤\n│犯   罪   日  期      │                    │                    │                    │\n├───────────┼──────────┼──────────┼──────────┤\n│偵查（自訴）機關      │    臺中地檢        │    臺中地檢        │                    │\n│年   度   案  號      │  年偵字第    號    │  年偵字第     號   │                    │\n├─┬─────────┼──────────┼──────────┼──────────┤\n│最│法        院      │                    │                    │                    │\n│後├─────────┼──────────┼──────────┼──────────┤\n│事│案        號      │  年度   字第    號 │  年度    字第    號│                    │\n│實├─────────┼──────────┼──────────┼──────────┤\n│審│判  決 日 期      │                    │                    │                    │\n├─┼─────────┼──────────┼──────────┼──────────┤\n│確│法        院      │    臺中地院        │   臺中高分院       │                    │\n│定├─────────┼──────────┼──────────┼──────────┤\n│判│案        號      │  年度  字第    號  │  年度    字第    號│                    │\n│決├─────────┼──────────┼──────────┼──────────┤\n│  │判決確定日期      │                    │                    │                    │\n├─┴─────────┼──────────┼──────────┼──────────┤\n│所犯法條              │                    │                    │                    │\n├───────────┼──────────┼──────────┼──────────┤\n│合於96年罪犯減刑條例  │                    │ 第2條第3款         │                    │\n│條例                  │                    │                    │                    │\n├───────────┼──────────┼──────────┼──────────┤\n│減刑後徒刑、拘役或罰金│                    │                    │                    │\n│額或或褫奪公權期間    │                    │                    │                    │\n├───────────┼──────────┼──────────┼──────────┤\n│備註                  │                    │                    │                    │\n└───────────┴──────────┴──────────┴─────