 名  │         竊盜             │                          │\n ├───────┼─────────────┼─────────────┤\n │  宣  告  刑  │    有期徒刑2年6月        │                          │\n ├───────┼─────────────┼─────────────┤\n │  所 犯 法 條 │       刑法第321條        │                          │\n ├───────┼─────────────┼─────────────┤\n │  犯 罪 日 期 │       88年03月16日       │                          │\n ├───┬───┼─────────────┼─────────────┤\n │偵    │機  關│  臺灣台南地方法院檢察署  │                          │\n │    及├───┼─────────────┼─────────────┤\n │查    │  年  │          88              │                          │\n │    案├───┼─────────────┼─────────────┤\n │年    │  字  │          偵              │                          │\n │    號├───┼─────────────┼─────────────┤\n │度    │  號  │         5866             │                          │\n ├───┼───┼─────────────┼─────────────┤\n │      │法  院│  臺灣高等法院台南分院    │                          │\n │      ├─┬─┼─────────────┼─────────────┤\n │  最  │  │年│          90              │                          │\n │      │案├─┼─────────────┼─────────────┤\n │  後  │  │字│         上訴             │                          │\n │      │號├─┼─────────────┼─────────────┤\n │  事  │  │號│          252             │                          │\n │      ├─┼─┼─────────────┼─────────────┤\n │  實  │判│年│          90              │                          │\n │      │決├─┼─────────────┼─────────────┤\n │  審  │日│月│          04              │                          │\n │      │期├─┼─────────────┼─────────────┤\n │      │  │日│          26              │                          │\n ├───┼─┴─┼─────────────┼─────────────┤\n │      │法  院│ 臺灣高等法院台南分院     │                          │\n │      ├─┬─┼─────────────┼─────────────┤\n │      │  │年│          90              │                          │\n │  確  │案├─┼─────────────┼─────────────┤\n │      │  │月│         上訴             │                          │\n │  定  │號├─┼─────────────┼─────────────┤\n │      │  │日│          252             │                  