20          │94.07.14            │\n├──┴────┼─────────┼─────────┼─────────┼─────────┼─────────┼──────────┤\n│合於中華民國九│合                │合                │合                │合                │合                │合                  │\n│十六年罪犯減刑│                  │                  │                  │                  │                  │                    │\n│條例          │                  │                  │                  │                  │                  │                    │\n├───────┼─────────┼─────────┼─────────┼─────────┼─────────┼──────────┤\n│減刑後宣告刑  │有期徒刑4 月，如易│有期徒刑3月15日， │有期徒刑6月，如易 │有期徒刑2 月15日，│有期徒刑3月，如易 │有期徒刑5月，如易科 │\n│              │科罰金以銀元300 元│如易科罰金以銀元  │科罰金以銀元300 元│如易科罰金以銀元  │科罰金以銀元300 元│罰金以銀元300 元折算│\n│              │折算壹日          │300 元折算壹日    │折算壹日          │300 元折算壹日    │折算壹日          │壹日                │\n│              │                  │                  │                  │                  │                  │                    │\n│              │                  │                  │                  │                  │                  │                    │\n└───────┴─────────┴─────────┴─────────┴─────────┴─────────┴──────────┘\n",
