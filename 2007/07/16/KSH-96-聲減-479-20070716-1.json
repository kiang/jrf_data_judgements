           │\n │  確  │案├─┼─────────────┼─────────────┤\n │      │  │字│上訴                      │上易                      │\n │  定  │號├─┼─────────────┼─────────────┤\n │      │  │號│1838                      │1295                      │\n │  日  ├─┼─┼─────────────┼─────────────┤\n │      │確│年│87                        │87                        │\n │  期  │定├─┼─────────────┼─────────────┤\n │      │日│月│12                        │7                         │\n │      │期├─┼─────────────┼─────────────┤\n │      │  │日│12                        │27                        │\n ├───┴─┴─┼─────────────┼─────────────┤\n │合於中華民國九│不得減刑                  │減為有期徒刑五月          │\n │十六年罪犯減刑│                          │                          │\n │條例          │                          │                          │\n ├───────┼─────────────┼─────────────┤\n │減刑刑期褫奪公│                          │                          │\n │權期間或罰金額│                          │                          │\n ├───────┼─────────────┼─────────────┤\n │ 附         註│                          │                          │\n └───────┴─────────────┴─────────────┘\n",
