   │      │      │        │      │    │    │利範圍│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │：1000│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │分之60│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │，東安│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │段1371│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │建號，│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │面積11│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │07.1 8│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │平方公│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │尺，權│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │利範圍│\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │10000 │\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │分之  │\n│  │    │        │        │        │      │      │      │      │      │      │        │      │    │    │151   │\n└─┴──┴────┴────┴────┴───┴───┴───┴───┴───┴───┴────┴───┴──┴──┴───┘\n",
