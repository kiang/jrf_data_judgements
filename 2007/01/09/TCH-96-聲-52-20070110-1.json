表\n┌────────┬──────────┬───────────┬──────────┐\n│罪            名│槍砲彈藥刀械管制條例│                      │                    │\n│                │                    │                      │                    │\n│                │                    │                      │                    │\n├────────┼──────────┼───────────┼──────────┤\n│宣     告     刑│有期徒刑3年6月罰金新│                      │                    │\n│                │臺幣50000元         │                      │                    │\n│                │                    │                      │                    │\n├────────┼──────────┼───────────┼──────────┤\n│犯   罪   日  期│93年12月中旬某日    │                      │                    │\n│                │                    │                      │                    │\n│                │                    │                      │                    │\n├────────┼──────────┼───────────┼──────────┤\n│                │                    │                      │                    │\n│偵查（自訴）機關│臺中地檢            │                      │                    │\n│年   度   案  號│94年度偵字第11165號 │                      │                    │\n│                │                    │                      │                    │\n├─┬──────┼──────────┼───────────┼──────────┤\n│  │法        院│臺灣臺中地方法院    │                      │                    │\n│最├──────┼──────────┼───────────┼──────────┤\n│後│            │                    │                      │                    │\n│事│案        號│94年度訴字第2756號  │                      │                    │\n│實│            │                    │                      │                    │\n│審├──────┼──────────┼───────────┼──────────┤\n│  │判  決 日 期│94年10月7日         │                      │                    │\n│  │            │                    │                      │                    │\n│  │            │                    │                      │                    │\n├─┼──────┼──────────┼───────────┼──────────┤\n│確│法        院│ 台中地院           │                      │                    │\n│定├──────┼──────────┼───────────┼──────────┤\n│判│            │                    │                      │                    │\n│決│案        號│94年度訴字第2756號  │                      │                    │\n│  ├──────┼──────────┼───────────┼──────────┤\n│  │判決確定日期│94年10月28日        │                      │                    │\n│  │            │                    │                      │                    │\n│  │            │                    │                      │                    │\n├─┴──────┼──────────┼───────────┼──────────┤\n│                │                    │                      │                    │\n│                │    臺中地檢        │                      │                    │\n│備            註│94年度執字第11377號 │                      │                    │\n└────────┴──────────┴───────────┴──────────┘\n",
